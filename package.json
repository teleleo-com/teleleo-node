{
  "name": "teleleo",
  "version": "0.1.0",
  "description": "The official TypeScript and JavaScript library for the Teleleo API: SMS, calls, USSD and modem control",
  "keywords": [
    "teleleo",
    "sms",
    "sms api",
    "gsm modem",
    "sim",
    "ussd",
    "calls",
    "socks proxy",
    "vpn",
    "api client",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/teleleo-com/teleleo-node#readme",
  "bugs": "https://github.com/teleleo-com/teleleo-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teleleo-com/teleleo-node.git"
  },
  "license": "MIT",
  "author": "Teleleo <support@teleleo.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "api.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "typecheck:examples": "tsc -p tsconfig.examples.json"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
